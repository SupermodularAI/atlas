<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Company }} — primitive atlas</title>
<style>
:root {
  --bg: #fbfbfa; --surface: #fff; --border: #e4e4e2; --text: #1a1a19;
  --muted: #6b6b68; --accent: #2b5fd9; --warn-bg: #fff8e6; --warn-border: #e0c068;
  --lock-bg: #f4f4f2;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161614; --surface: #1e1e1c; --border: #33332f; --text: #ececea;
    --muted: #9a9a95; --accent: #8fa9f0; --warn-bg: #2c2413; --warn-border: #6b5722;
    --lock-bg: #232320;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 2rem 1.25rem; background: var(--bg); color: var(--text);
  font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
}
main { max-width: 60rem; margin: 0 auto; }
h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
h2 { font-size: 1.1rem; margin: 2rem 0 .75rem; }
.meta, .claim { color: var(--muted); font-size: .84rem; }
.claim { margin: .75rem 0 0; padding: .7rem .85rem; border-left: 2px solid var(--border); }
code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }
.notice, .warnings {
  margin: 1.25rem 0; padding: .8rem 1rem; background: var(--warn-bg);
  border: 1px solid var(--warn-border); border-radius: 6px; font-size: .88rem;
}
.card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  padding: 1rem 1.1rem; margin: .75rem 0;
}
.card.withheld { background: var(--lock-bg); }
.card.excluded { border-left: 3px solid var(--warn-border); }
.card.restricted { border-left: 3px solid var(--muted); }
.card h3 { margin: 0 0 .3rem; font-size: 1rem; }
.tag {
  display: inline-block; font-size: .72rem; padding: .1rem .45rem; border-radius: 4px;
  border: 1px solid var(--border); color: var(--muted); margin-left: .4rem; vertical-align: 1px;
}
.tag.excluded { border-color: var(--warn-border); color: var(--text); }
.tag.restricted { border-color: var(--muted); }
.desc { margin: .35rem 0 .6rem; }
ul.prims { list-style: none; margin: .5rem 0 0; padding: 0; }
ul.prims li { padding: .3rem 0; border-top: 1px solid var(--border); }
.ptype {
  display: inline-block; min-width: 4.5rem; color: var(--muted);
  font-size: .74rem; text-transform: uppercase; letter-spacing: .04em;
}
pre {
  background: var(--lock-bg); border: 1px solid var(--border); border-radius: 6px;
  padding: .55rem .7rem; margin: .5rem 0 0; font-size: .82rem;
  /* Install URLs are long. Wrap rather than scroll sideways: a partially
     visible command gets copied partially. pre-wrap keeps the newline that
     separates the two commands. */
  white-space: pre-wrap; overflow-wrap: anywhere;
}
.unavailable { border-style: dashed; }

/* --- toolbar, index, and collapsible primitive lists ---------------------
   Added after the first run against a real marketplace: 73 primitives across
   8 packages rendered as 8.2 screens of flat list with no navigation. The
   design was correct for the 4-primitive fixture it was reviewed against and
   did not survive the scale. */
.toolbar {
  display: flex; gap: .5rem; align-items: center; flex-wrap: wrap;
  margin: 1.25rem 0 .5rem;
}
.toolbar input[type=search] {
  flex: 1 1 16rem; min-width: 0; padding: .4rem .6rem; font: inherit;
  color: var(--text); background: var(--surface);
  border: 1px solid var(--border); border-radius: 6px;
}
.toolbar button {
  padding: .4rem .6rem; font: inherit; font-size: .84rem; cursor: pointer;
  color: var(--muted); background: var(--surface);
  border: 1px solid var(--border); border-radius: 6px;
}
.toolbar button:hover { color: var(--text); }

ul.index {
  list-style: none; margin: .25rem 0 1.5rem; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  gap: .15rem .9rem;
}
ul.index li {
  display: flex; gap: .5rem; align-items: baseline;
  padding: .2rem 0; border-top: 1px solid var(--border); font-size: .88rem;
}
/* Required, not redundant. The hidden attribute only works through the UA rule
   [hidden] { display: none }, and the author `display: flex` above beats any
   UA declaration in the cascade. Without this the filter sets li.hidden and
   the row keeps rendering, so the index contradicts the result count beside
   the search box. Any element toggled via .hidden must either avoid setting
   display or carry an override like this one. */
ul.index li[hidden] { display: none; }
ul.index a { color: var(--accent); text-decoration: none; }
ul.index a:hover { text-decoration: underline; }

details summary {
  cursor: pointer; color: var(--muted); font-size: .84rem;
  padding: .3rem 0; border-top: 1px solid var(--border);
}
details summary:hover { color: var(--text); }
details[open] summary { margin-bottom: .2rem; }

/* Each primitive row is short, so a single column wastes most of the width. */
details ul.prims {
  columns: 2; column-gap: 1.5rem;
}
details ul.prims li { break-inside: avoid; }
@media (max-width: 46rem) {
  details ul.prims { columns: 1; }
}

/* --- empty state ---------------------------------------------------------
   A query matching nothing used to hide every card and leave the source
   headings stranded above a screen of blank space: indistinguishable from a
   page that had broken. The count beside the input is a status readout, not
   an explanation, so the content area has to say something itself. */
.empty {
  display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap;
  margin: 2rem 0; padding: 1rem 1.1rem; color: var(--muted);
  background: var(--surface); border: 1px dashed var(--border);
  border-radius: 8px;
}
/* Required, exactly as for ul.index li above: the `display: flex` on .empty
   would beat the UA [hidden] { display: none } rule, so the empty state would
   stay painted over the restored results after the filter is cleared. Any
   element this page toggles via the hidden attribute must either set no
   display or carry an override like this one. */
.empty[hidden] { display: none; }
.empty button {
  padding: .3rem .55rem; font: inherit; font-size: .84rem; cursor: pointer;
  color: var(--muted); background: var(--bg);
  border: 1px solid var(--border); border-radius: 6px;
}
.empty button:hover { color: var(--text); }
</style>
</head>
<body>
<main>
  <h1>{{ .Company }} — primitive atlas</h1>
  <p class="meta">
    Generated {{ .GeneratedAt }} · schema v{{ .SchemaVersion }} ·
    {{ index .Summary.Sources "read" }} of {{ len .Sources }} sources read ·
    {{ index .Summary.Packages "harvested" }} packages harvested,
    {{ index .Summary.Packages "restricted" }} restricted,
    {{ index .Summary.Packages "excluded" }} withheld
  </p>

  <p class="claim">
    This atlas asserts only that these primitives were published at these sources,
    at these resolved commit SHAs, read at the time shown above, by a principal with
    the access recorded here. It does <strong>not assert</strong> that anything was
    approved, reviewed, unaltered, or authorised to run — those are not claims any
    part of this system can make.
  </p>

  {{ if .Warnings }}
  <div class="warnings">
    <strong>Warnings ({{ len .Warnings }}).</strong>
    A signal that does not block generation but should stay visible.
    <ul>
      {{ range .Warnings }}
      <li><span class="tag">{{ .Kind }}</span> <span class="mono">{{ .Source }}</span> — {{ .Detail }}</li>
      {{ end }}
    </ul>
  </div>
  {{ end }}

  {{ if .Collisions }}
  <div class="notice">
    <strong>Name collisions ({{ len .Collisions }}).</strong>
    A package name is only meaningful relative to its source, so the same name can
    legitimately appear in more than one. Both are listed; nothing is hidden.
    <ul>
      {{ range .Collisions }}
      <li><span class="mono">{{ .Name }}</span> — {{ .Kind }}, in
        {{ range $i, $s := .Sources }}{{ if $i }}, {{ end }}<span class="mono">{{ $s }}</span>{{ end }}
      </li>
      {{ end }}
    </ul>
  </div>
  {{ end }}

  <div class="toolbar">
    <input type="search" id="q" placeholder="Filter primitives and packages…"
           autocomplete="off" spellcheck="false" aria-label="Filter primitives and packages">
    <span class="meta" id="qcount"></span>
    <button type="button" id="expand">Expand all</button>
    <button type="button" id="collapse">Collapse all</button>
  </div>

  <ul class="index">
    {{ range $pkg := .Packages }}
    <li>
      <a href="#pkg-{{ $pkg.Name }}"><span class="mono">{{ $pkg.Name }}</span></a>
      {{ if eq $pkg.Access "public" }}<span class="meta">{{ len $pkg.Primitives }}</span>
      {{ else if eq $pkg.Access "excluded" }}<span class="tag excluded">withheld</span>
      {{ else }}<span class="tag restricted">unreadable</span>{{ end }}
    </li>
    {{ end }}
  </ul>

  {{ range $src := .Sources }}
  <section class="src">
  <h2>{{ $src.Name }} <span class="tag">{{ $src.Kind }}</span></h2>

  {{ if eq $src.Status "unavailable" }}
    <div class="card unavailable">
      <p class="desc">Source <span class="mono">{{ $src.Name }}</span> could not be
      read — its packages are not listed. This is an unknown unknown: Atlas does not
      know what this source would have contained.</p>
      <p class="meta">Reason: {{ $src.Reason }}</p>
    </div>
  {{ else }}
    {{ if $src.Owner }}<p class="meta">Owner {{ $src.Owner }}{{ if $src.Version }} · version {{ $src.Version }}{{ end }}</p>{{ end }}
    {{ range $pkg := $.Packages }}{{ if eq $pkg.Source $src.Name }}
      <div class="card{{ if eq $pkg.Access "excluded" }} withheld excluded{{ else if eq $pkg.Access "restricted" }} withheld restricted{{ end }}" id="pkg-{{ $pkg.Name }}">
        <h3>{{ $pkg.Name }}
          {{ if eq $pkg.Access "excluded" }}<span class="tag excluded">withheld by descriptor</span>{{ end }}
          {{ if eq $pkg.Access "restricted" }}<span class="tag restricted">access restricted</span>{{ end }}
          {{ if $pkg.Version }}<span class="tag">{{ $pkg.Version }}</span>{{ end }}
        </h3>
        {{ if $pkg.Description }}<p class="desc">{{ $pkg.Description }}</p>{{ end }}

        {{ if eq $pkg.Access "public" }}
          {{ if $pkg.ResolvedSha }}<p class="meta mono">{{ $pkg.ResolvedSha }}</p>{{ end }}
          {{ if $pkg.Primitives }}
            <details>
              <summary data-total="{{ len $pkg.Primitives }}"><span class="scount">{{ len $pkg.Primitives }} primitive{{ if ne (len $pkg.Primitives) 1 }}s{{ end }}</span></summary>
              <ul class="prims">
                {{ range $pkg.Primitives }}
                <li><span class="ptype">{{ .Type }}</span><span class="mono">{{ .Name }}</span>
                  {{ if .Description }}<div class="meta">{{ .Description }}</div>{{ end }}
                </li>
                {{ end }}
              </ul>
            </details>
          {{ else }}
            <p class="meta">No primitives found in this package.</p>
          {{ end }}
          {{ if $pkg.Install }}
<pre>{{ if $pkg.Install.MarketplaceAdd }}{{ $pkg.Install.MarketplaceAdd }}
{{ end }}{{ $pkg.Install.Install }}</pre>
          {{ end }}
        {{ else }}
          <p class="meta">
            {{ if eq $pkg.Access "excluded" }}Primitives not listed — Atlas could have
            read this package but was told to withhold it{{ else }}Primitives not
            listed — Atlas was not able to read this package{{ end }}
            {{ if $pkg.Reason }} ({{ $pkg.Reason }}){{ end }}.
          </p>
        {{ end }}
      </div>
    {{ end }}{{ end }}
  {{ end }}
  </section>
  {{ end }}

  <p class="empty" id="empty" hidden>No primitives match
    &ldquo;<span id="emptyterm"></span>&rdquo;.
    <button type="button" id="clearq">Clear filter</button>
  </p>
</main>

<script>
/* Filter and expand/collapse. Deliberately operates on the DOM that
   html/template already escaped — it reads textContent and never interpolates a
   harvested string into markup or code, so the single escaping guard in the
   template remains the only one needed. No external requests: the page stays
   self-contained and opens from file://. Degrades to a fully readable page with
   JS off, because every primitive is present in the HTML and <details> works
   natively. */
(function () {
  var q = document.getElementById('q');
  var count = document.getElementById('qcount');
  var cards = Array.prototype.slice.call(document.querySelectorAll('.card[id]'));
  var indexItems = Array.prototype.slice.call(document.querySelectorAll('.index li'));
  var sections = Array.prototype.slice.call(document.querySelectorAll('section.src'));
  var empty = document.getElementById('empty');
  var emptyTerm = document.getElementById('emptyterm');

  function setDetails(open) {
    Array.prototype.forEach.call(document.querySelectorAll('details'), function (d) {
      d.open = open;
    });
  }
  document.getElementById('expand').addEventListener('click', function () { setDetails(true); });
  document.getElementById('collapse').addEventListener('click', function () { setDetails(false); });

  /* The URL is the only state a static page can carry, and "send me the review
     primitives" is most of this page's value. It must replace the current
     history entry rather than push a new one: this runs on every keystroke, so
     pushing would bury the page the reader arrived from under one history
     entry per typed character, and the back button would stop working.

     Wrapped because a file:// document has an opaque origin, where a
     replaceState call carrying a URL can raise a SecurityError. This page is
     designed to open straight from disk, so that path is normal use, not an
     edge case — and an exception escaping here would propagate out of the
     input handler and kill filtering entirely on every keystroke. Losing the
     shareable URL on file:// is an acceptable degradation; losing the filter
     is not. */
  function syncURL(raw) {
    try {
      var u = new URL(location.href);
      // URLSearchParams handles the encoding. Building this query string by
      // concatenation would corrupt any term containing & or #.
      if (raw === '') { u.searchParams.delete('q'); } else { u.searchParams.set('q', raw); }
      history.replaceState(history.state, '', u);
    } catch (e) { /* opaque origin: filtering still works, the URL cannot carry it. */ }
  }

  function filter() {
    // raw drives the URL and the echoed message so the reader sees the term
    // they typed; term is the lowercased form used only for matching.
    var raw = q.value.trim();
    var term = raw.toLowerCase();
    var shownPrims = 0, shownCards = 0;

    cards.forEach(function (card) {
      var rows = Array.prototype.slice.call(card.querySelectorAll('ul.prims li'));
      var cardText = (card.querySelector('h3').textContent + ' ' +
        (card.querySelector('.desc') ? card.querySelector('.desc').textContent : '')).toLowerCase();
      var cardMatches = term === '' || cardText.indexOf(term) !== -1;
      var anyRow = false;

      // A package-level match shows the package CARD but does not disable
      // primitive-level filtering. Several package descriptions contain common
      // words ("code review", "automated MR review"), so treating a package hit
      // as "show everything inside" made a search for "review" return 54 of 73
      // primitives — a count that tells the reader nothing.
      var rowHits = 0;
      rows.forEach(function (li) {
        var hit = term === '' || li.textContent.toLowerCase().indexOf(term) !== -1;
        li.hidden = !hit;
        if (hit) { rowHits++; shownPrims++; }
      });
      anyRow = rowHits > 0;

      var visible = cardMatches || anyRow;
      card.hidden = !visible;
      if (visible) shownCards++;
      // Open a package when a primitive inside it matched, so a hit is never
      // hidden behind a collapsed section.
      var d = card.querySelector('details');
      if (d && term !== '' && anyRow) d.open = true;

      // The summary count must describe what is actually listed beneath it.
      // Left alone it read "26 primitives" above four filtered rows.
      var sum = card.querySelector('details > summary');
      var lbl = sum && sum.querySelector('.scount');
      if (lbl) {
        var total = +sum.getAttribute('data-total');
        lbl.textContent = (term === '' || rowHits === total)
          ? total + ' primitive' + (total === 1 ? '' : 's')
          : rowHits + ' of ' + total + ' primitives';
      }
    });

    indexItems.forEach(function (li) {
      var a = li.querySelector('a');
      var target = a && document.getElementById(a.getAttribute('href').slice(1));
      li.hidden = !!(target && target.hidden);
    });

    // Hide a source heading block once every package under it is filtered out,
    // so the h2 and its owner/version line do not stand over empty space.
    //
    // Guarded on there being at least one filterable card: an unavailable
    // source renders a stub card with no id, which the filter never touches
    // and which therefore reports zero visible cards. Hiding on "all cards
    // hidden" alone would make that section vacuously eligible and delete the
    // "could not be read" disclosure the moment anyone typed a character
    // (spec §7). A source with nothing to filter always stays visible: the
    // stub is a disclosure about missing data, not a search result.
    sections.forEach(function (sec) {
      var own = Array.prototype.slice.call(sec.querySelectorAll('.card[id]'));
      sec.hidden = own.length > 0 && own.every(function (c) { return c.hidden; });
    });

    // Set as text, never as markup. The term arrives from the query string,
    // which any third party can author, so this is the one place on the page
    // where untrusted input is written into the DOM at runtime. A textContent
    // assignment cannot create an element, so markup in ?q= lands as visible
    // text. Assigning an HTML string here instead would be an XSS sink, which
    // is why the guard test bans those APIs from this block by name.
    emptyTerm.textContent = raw;
    empty.hidden = !(term !== '' && shownCards === 0 && shownPrims === 0);

    count.textContent = term === '' ? '' :
      shownCards + ' package' + (shownCards === 1 ? '' : 's') +
      ', ' + shownPrims + ' primitive' + (shownPrims === 1 ? '' : 's');

    syncURL(raw);
  }

  q.addEventListener('input', filter);
  q.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { q.value = ''; filter(); }
  });
  // Clearing through the same path as Escape and typing, so the URL parameter
  // is dropped by the one syncURL call at the end of filter().
  document.getElementById('clearq').addEventListener('click', function () {
    q.value = '';
    filter();
    q.focus();
  });

  /* Prime the filter from ?q= so a filtered view survives reload and can be
     shared. Assigning to input.value is a text assignment, not a markup one:
     the value never becomes HTML, so a crafted ?q= cannot inject anything
     here either. Only run filter() when there is something to apply, to keep
     the no-parameter load byte-identical in behaviour to before. */
  try {
    var initial = new URL(location.href).searchParams.get('q');
    if (initial) { q.value = initial; filter(); }
  } catch (e) { /* no URL support: the page is simply unfiltered. */ }
})();
</script>
</body>
</html>
